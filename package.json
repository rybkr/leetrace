{
  "name": "leetrace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "lint": "eslint server frontend/src frontend/vite.config.ts tests eslint.config.js",
    "test": "vitest run",
    "build": "tsc -p tsconfig.server.json && cp server/runner-worker.py dist/server/runner-worker.py && vite build --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "framer-motion": "^11.11.0",
    "monaco-editor": "^0.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
