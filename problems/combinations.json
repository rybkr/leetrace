  "description": "Given two integers n and k, return all possible combinations of k numbers chosen from the range [1, n].\nYou may return the answer in any order.\n \nExample 1:\n\nInput: n = 4, k = 2\nOutput: [[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]]\nExplanation: There are 4 choose 2 = 6 total combinations.\nNote that combinations are unordered, i.e., [1,2] and [2,1] are considered to be the same combination.\n\nExample 2:\n\nInput: n = 1, k = 1\nOutput: [[1]]\nExplanation: There is 1 choose 1 = 1 total combination.\n\n \nConstraints:\n\n1 <= n <= 20\n1 <= k <= n\n\n",
  "entry_point": "Solution().combine",
  "starter_code": "class Solution:\n    def combine(self, n: int, k: int) -> List[List[int]]:\n        ",
  "preamble": "from typing import *\nfrom collections import *\nfrom functools import *\nfrom itertools import *\nfrom heapq import *\nfrom bisect import *\nfrom math import *\nimport math, collections, functools, itertools, bisect, heapq, string, re\n",
  "check_function": "def check(candidate):\n    assert sorted(map(tuple, candidate(n = 4, k = 2))) == sorted(map(tuple, [[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]]))\n    assert sorted(map(tuple, candidate(n = 1, k = 1))) == sorted(map(tuple, [[1]]))\n    assert sorted(map(tuple, candidate(n = 5, k = 1))) == sorted(map(tuple, [[1],[2],[3],[4],[5]]))\n    assert sorted(map(tuple, candidate(n = 5, k = 5))) == sorted(map(tuple, [[1,2,3,4,5]]))\n    assert sorted(map(tuple, candidate(n = 5, k = 3))) == sorted(map(tuple, [[1,2,3],[1,2,4],[1,2,5],[1,3,4],[1,3,5],[1,4,5],[2,3,4],[2,3,5],[2,4,5],[3,4,5]]))\n    assert sorted(map(tuple, candidate(n = 6, k = 2))) == sorted(map(tuple, [[1,2],[1,3],[1,4],[1,5],[1,6],[2,3],[2,4],[2,5],[2,6],[3,4],[3,5],[3,6],[4,5],[4,6],[5,6]]))\n    assert sorted(map(tuple, candidate(n = 6, k = 4))) == sorted(map(tuple, [[1,2,3,4],[1,2,3,5],[1,2,3,6],[1,2,4,5],[1,2,4,6],[1,2,5,6],[1,3,4,5],[1,3,4,6],[1,3,5,6],[1,4,5,6],[2,3,4,5],[2,3,4,6],[2,3,5,6],[2,4,5,6],[3,4,5,6]]))\n    assert len(candidate(n = 8, k = 3)) == 56",
  "test_cases": [
    "assert sorted(map(tuple, candidate(n = 4, k = 2))) == sorted(map(tuple, [[1,2],[1,3],[1,4],[2,3],[2,4],[3,4]]))",
    "assert sorted(map(tuple, candidate(n = 1, k = 1))) == sorted(map(tuple, [[1]]))",
    "assert sorted(map(tuple, candidate(n = 5, k = 1))) == sorted(map(tuple, [[1],[2],[3],[4],[5]]))",
    "assert sorted(map(tuple, candidate(n = 5, k = 5))) == sorted(map(tuple, [[1,2,3,4,5]]))",
    "assert sorted(map(tuple, candidate(n = 5, k = 3))) == sorted(map(tuple, [[1,2,3],[1,2,4],[1,2,5],[1,3,4],[1,3,5],[1,4,5],[2,3,4],[2,3,5],[2,4,5],[3,4,5]]))",
    "assert sorted(map(tuple, candidate(n = 6, k = 2))) == sorted(map(tuple, [[1,2],[1,3],[1,4],[1,5],[1,6],[2,3],[2,4],[2,5],[2,6],[3,4],[3,5],[3,6],[4,5],[4,6],[5,6]]))",
    "assert sorted(map(tuple, candidate(n = 6, k = 4))) == sorted(map(tuple, [[1,2,3,4],[1,2,3,5],[1,2,3,6],[1,2,4,5],[1,2,4,6],[1,2,5,6],[1,3,4,5],[1,3,4,6],[1,3,5,6],[1,4,5,6],[2,3,4,5],[2,3,4,6],[2,3,5,6],[2,4,5,6],[3,4,5,6]]))",
    "assert len(candidate(n = 8, k = 3)) == 56"
